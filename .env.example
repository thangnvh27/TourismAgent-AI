PORT=3000
# Per-account daily tour-generation requests (including failed requests)
DAILY_GENERATE_LIMIT=3
N8N_TRIP_URL=https://YOUR_N8N/webhook/generate-trip-v3
N8N_GUIDE_URL=https://YOUR_N8N/webhook/virtual-guide-v3
# Header Auth X-Tourism-Key on BOTH n8n webhooks
N8N_WEBHOOK_SECRET=

# Firebase Spark / Cloud Firestore default database
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Private key file OUTSIDE the frontend/repository. Do not paste key contents here.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional alternative to a key file: use already configured Application Default Credentials
FIREBASE_USE_ADC=false
# Cleanup is bounded and dry-run unless --apply is passed
CLEANUP_BATCH_LIMIT=100
